{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["tests/**/*.ts", "scripts/**/*.mjs"],
  "exclude": [
    "dist",
    "node_modules",
    "test-artifacts",
    ".worktrees",
    ".tmp",
    ".cache"
  ]
}
