{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Save V9 Native Boundary",
  "type": "object",
  "required": [
    "saveVersion",
    "gameVersion",
    "seed",
    "clock",
    "urbanFabric",
    "zoningV2",
    "buildingsV2",
    "propertyMarket"
  ],
  "properties": {
    "saveVersion": { "const": 9 },
    "gameVersion": { "const": "0.9.0-urban-fabric" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "clock": {
      "type": "object",
      "required": ["tick", "speed"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "speed": { "enum": [0, 1, 2, 4] }
      },
      "additionalProperties": true
    },
    "urbanFabric": { "type": "object", "required": ["parcels"] },
    "zoningV2": { "type": "object", "required": ["parcelAssignments"] },
    "buildingsV2": { "type": "array" },
    "propertyMarket": {
      "type": "object",
      "required": ["holdings", "transactions"]
    }
  },
  "additionalProperties": true
}
