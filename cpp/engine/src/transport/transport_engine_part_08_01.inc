ModeChoiceResult ModeChoice::choose(const ModeChoiceInput& i)const{auto cost=[](const ModeAlternative&a){if(!a.available)return std::numeric_limits<double>::infinity();const double vals[]{a.travel_time,a.waiting,a.transfers,a.fare,a.fuel,a.toll,a.parking,a.comfort_penalty,a.accessibility_penalty};double c=0;for(double v:vals)c+=std::max(0.0,std::isfinite(v)?v:0.0);return c;};const auto car=cost(i.car),transit=cost(i.transit);if(!std::isfinite(car)&&!std::isfinite(transit))return {TravelMode::unmet,car,transit,std::numeric_limits<double>::infinity()};if(transit<car-eps)return {TravelMode::transit,car,transit,transit};return {TravelMode::car,car,transit,car};}

void validate_transit(const TransitNetworkSnapshot& s){auto stops=index_unique<TransitStop,TransitStopId>(s.stops,[](const auto&v){return v.id;},"transit stop");index_unique<TransitLine,TransitLineId>(s.lines,[](const auto&v){return v.id;},"transit line");for(const auto& st:s.stops){finite(st.x,"transit stop x");finite(st.y,"transit stop y");}for(const auto& l:s.lines){nonnegative(l.fare,"transit fare");if(l.enabled&&l.stop_ids.size()<2)fail("enabled transit line requires two stops");unique_refs(l.stop_ids,"transit line stops");for(const auto& id:l.stop_ids){auto it=stops.find(id);if(it==stops.end())fail("transit line references missing stop");if(it->second->mode!=l.mode)fail("transit line stop mode mismatch");}}}
void TransitNetwork::upsert_stop(TransitStop s){require_id(s.id,"transit stop");finite(s.x,"transit stop x");finite(s.y,"transit stop y");for(const auto& [id,v]:stops_)if(id!=s.id&&std::abs(v.x-s.x)<=eps&&std::abs(v.y-s.y)<=eps)fail("duplicate transit stop coordinate");stops_[s.id]=std::move(s);++revision_;}
void TransitNetwork::upsert_line(TransitLine l){require_id(l.id,"transit line");TransitNetworkSnapshot candidate=snapshot();candidate.lines.erase(std::remove_if(candidate.lines.begin(),candidate.lines.end(),[&](const auto& v){return v.id==l.id;}),candidate.lines.end());candidate.lines.push_back(l);validate_transit(candidate);lines_[l.id]=std::move(l);++revision_;}
bool TransitNetwork::remove_stop(const TransitStopId& id){if(!stops_.erase(id))return false;for(auto& [_,line]:lines_)if(std::erase(line.stop_ids,id)>0&&line.stop_ids.size()<2)line.enabled=false;++revision_;return true;}
bool TransitNetwork::remove_line(const TransitLineId& id){if(!lines_.erase(id))return false;++revision_;return true;}
TransitNetworkSnapshot TransitNetwork::snapshot()const{TransitNetworkSnapshot s;s.revision=revision_;for(auto [_,v]:stops_)s.stops.push_back(v);for(auto [_,v]:lines_)s.lines.push_back(v);return s;}
void TransitNetwork::restore(const TransitNetworkSnapshot& s){validate_transit(s);stops_.clear();lines_.clear();for(auto v:s.stops)if(!stops_.emplace(v.id,v).second)fail("duplicate transit stop restore");for(auto v:s.lines)if(!lines_.emplace(v.id,v).second)fail("duplicate transit line restore");revision_=s.revision;}
