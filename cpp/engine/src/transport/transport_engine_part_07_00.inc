void ParkingSystem::upsert(ParkingFacility f){require_id(f.id,"parking facility");require_id(f.access_junction_id,"parking access junction");nonnegative(f.capacity,"parking capacity");nonnegative(f.occupied,"parking occupied");nonnegative(f.price,"parking price");nonnegative(f.access_penalty_ticks,"parking access penalty");if(f.occupied>f.capacity+eps)fail("parking occupancy exceeds capacity");facilities_[f.id]=std::move(f);}
std::optional<ParkingReservationId> ParkingSystem::reserve(const ParkingFacilityId& id,double w){positive(w,"parking reservation weight");auto it=facilities_.find(id);if(it==facilities_.end()||it->second.occupied+w>it->second.capacity+eps)return std::nullopt;ParkingReservationId rid{"parking-reservation:"+std::to_string(next_reservation_id_++)};it->second.occupied+=w;reservations_[rid]={rid,id,w};return rid;}
void ParkingSystem::release(const ParkingReservationId& id){auto it=reservations_.find(id);if(it==reservations_.end())return;auto f=facilities_.find(it->second.facility_id);if(f!=facilities_.end())f->second.occupied=std::max(0.0,f->second.occupied-it->second.weight);reservations_.erase(it);}
double ParkingSystem::occupancy(const ParkingFacilityId& id)const{auto it=facilities_.find(id);if(it==facilities_.end())fail("unknown parking facility");return it->second.occupied;}
double ParkingSystem::generalized_penalty(const ParkingFacilityId& id)const{auto it=facilities_.find(id);if(it==facilities_.end())fail("unknown parking facility");const auto& f=it->second;const double scarcity=f.capacity<=eps?1000.0:20.0*std::pow(std::clamp(f.occupied/f.capacity,0.0,1.0),4);return f.price+f.access_penalty_ticks+scarcity;}
ParkingSnapshot ParkingSystem::snapshot()const{ParkingSnapshot s;s.next_reservation_id=next_reservation_id_;for(auto [_,v]:facilities_)s.facilities.push_back(v);for(auto [_,v]:reservations_)s.reservations.push_back(v);return s;}
void ParkingSystem::restore(const ParkingSnapshot& s){facilities_.clear();reservations_.clear();for(auto f:s.facilities){if(facilities_.contains(f.id))fail("duplicate parking facility");upsert(f);}for(auto r:s.reservations){require_id(r.id,"parking reservation");positive(r.weight,"parking reservation weight");if(!facilities_.contains(r.facility_id)||!reservations_.emplace(r.id,r).second)fail("invalid parking reservation restore");}next_reservation_id_=std::max<std::uint64_t>(1,s.next_reservation_id);}

void IncidentSystem::upsert(Incident i){require_id(i.id,"incident");require_id(i.carriageway_id,"incident carriageway");if(!std::isfinite(i.capacity_factor)||i.capacity_factor<0||i.capacity_factor>1)fail("incident capacity factor out of range");if(!std::isfinite(i.speed_factor)||i.speed_factor<0||i.speed_factor>1)fail("incident speed factor out of range");incidents_[i.id]=std::move(i);++cost_revision_;}
