        std::sort(open.begin(),open.end(),[](const Q&a,const Q&b){if(std::abs(a.g-b.g)>eps)return a.g<b.g;auto ak=state_key(a.j,a.in),bk=state_key(b.j,b.in);if(ak!=bk)return ak<bk;return a.incoming_arc<b.incoming_arc;});auto cur=open.front();open.erase(open.begin());auto ck=state_key(cur.j,cur.in);if(cur.g>best[ck]+eps)continue;if(cur.j==goal){goalkey=ck;break;}
        struct Next{const Carriageway* cw;const TurnMovement* mv;double penalty;};std::vector<Next> nexts;if(!cur.in){for(auto* cw:outgoing[cur.j])nexts.push_back({cw,nullptr,0});}else{for(auto* mv:moves[{cur.j,*cur.in}]){auto* cw=cws.at(mv->to_carriageway_id);if((mv->permissions&required)==0)continue;nexts.push_back({cw,mv,mv->base_penalty_ticks*cfg.intersection_delay_weight});}}
        std::sort(nexts.begin(),nexts.end(),[](const Next&a,const Next&b){const auto aid=a.mv?a.mv->id.value+">"+a.cw->id.value:a.cw->id.value;const auto bid=b.mv?b.mv->id.value+">"+b.cw->id.value:b.cw->id.value;return aid<bid;});
        for(const auto& n:nexts){auto tc=traversal(*n.cw);if(!std::isfinite(tc))continue;auto ng=cur.g+tc+n.penalty;auto nk=state_key(n.cw->to_junction_id,n.cw->id);auto it=best.find(nk);const std::string arc=(n.mv?n.mv->id.value+">":"origin>")+n.cw->id.value;bool improve=it==best.end()||ng<it->second-eps;bool tie=it!=best.end()&&std::abs(ng-it->second)<=eps&&arc<(edge.contains(nk)?((edge[nk].movement?edge[nk].movement->value+">":"origin>")+edge[nk].cw.value):"~");if(!improve&&!tie)continue;best[nk]=ng;prev[nk]=ck;edge[nk]={n.cw->id,n.mv?std::optional<MovementId>{n.mv->id}:std::nullopt};Q q{n.cw->to_junction_id,n.cw->id,ng,arc};state[nk]=q;open.push_back(q);}
    }
    if(goalkey.empty()){if(cacheable)cache_[key]=std::nullopt;return std::nullopt;}RouteResult r;std::string cursor=goalkey;while(cursor!=state_key(start,std::nullopt)){const auto& q=state.at(cursor);r.junction_ids.push_back(q.j);const auto& e=edge.at(cursor);r.carriageway_ids.push_back(e.cw);if(e.movement)r.movement_ids.push_back(*e.movement);cursor=prev.at(cursor);}r.junction_ids.push_back(start);std::reverse(r.junction_ids.begin(),r.junction_ids.end());std::reverse(r.carriageway_ids.begin(),r.carriageway_ids.end());std::reverse(r.movement_ids.begin(),r.movement_ids.end());r.total_cost=best[goalkey]+cfg.destination_parking_cost;if(cacheable)cache_[key]=r;return r;
}
void RoutingEngine::clear_cache(){cache_.clear();cached_topology_revision_=static_cast<std::uint64_t>(-1);}
