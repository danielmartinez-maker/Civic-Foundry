{
  "name": "civic-foundry",
  "version": "0.9.0-urban-fabric",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "assets:check": "python tools/render_isometric_atlases.py --check",
    "assets:build": "python tools/render_isometric_atlases.py",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp index.html dist/index.html && cp src/styles.css dist/styles.css && mkdir -p dist/vendor && cp node_modules/clipper2-ts/dist/clipper2.min.mjs dist/vendor/clipper2.min.mjs && python tools/render_isometric_atlases.py",
    "dev": "python -m http.server 5173 -d dist",
    "test:smoke": "python tests/smoke/phase6_smoke.py",
    "test:smoke:phase7": "python tests/smoke/phase7_land_housing_smoke.py",
    "test:smoke:isometric": "python tests/smoke/isometric_pass_a_smoke.py"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18"
  }
}
