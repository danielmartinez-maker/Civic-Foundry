{
  "name": "civic-foundry",
  "version": "0.9.0-urban-fabric",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint src tests",
    "policy:check": "node scripts/repository-policy.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "security:audit": "npm audit --audit-level=high",
    "assets:policy": "node scripts/check-assets.mjs",
    "assets:check": "python tools/render_isometric_atlases.py --check",
    "assets:build": "python tools/render_isometric_atlases.py",
    "build": "node scripts/build.mjs",
    "verify:fast": "npm run format:check && npm run lint && npm run policy:check && npm run architecture:check && npm run typecheck && npm run typecheck:tests && npm test && npm run assets:policy",
    "verify": "npm run verify:fast && npm run assets:check && npm run build",
    "cpp:round:test": "node scripts/cpp/run-native-round.mjs",
    "cpp:round:test:sanitized": "node scripts/cpp/run-native-round.mjs --preset round-debug-sanitized",
    "test:cpp-round-runner": "node --test tests/cpp-native-round-runner.test.mjs",
    "test:smoke:portable": "npm run test:smoke && npm run test:smoke:phase7 && npm run test:smoke:urban-fabric && npm run test:smoke:isometric && python tests/smoke/isometric_visual_smoke.py",
    "verify:full": "npm run verify && npm run test:smoke:portable",
    "dev": "python -m http.server 5173 -d dist",
    "desktop": "npm run build && electron desktop/main.mjs",
    "test:smoke": "python tests/smoke/phase6_smoke.py",
    "test:smoke:phase7": "python tests/smoke/phase7_land_housing_smoke.py",
    "test:smoke:urban-fabric": "python tests/smoke/urban_fabric_smoke.py",
    "test:smoke:isometric": "python tests/smoke/isometric_pass_a_smoke.py"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "44.0.0",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.67.0"
  }
}
