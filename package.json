{
  "name": "civic-foundry",
  "version": "0.9.0-urban-fabric",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "policy:check": "node scripts/repository-policy.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "format": "prettier --write package.json tsconfig.json eslint.config.mjs scripts/**/*.mjs tests/repository_policy.test.ts tests/architecture_policy.test.ts tests/build_script.test.ts tests/asset_policy.test.ts README.md CONTRIBUTING.md docs/ENGINEERING_STANDARDS.md docs/adr/**/*.md",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.mjs scripts/**/*.mjs tests/repository_policy.test.ts tests/architecture_policy.test.ts tests/build_script.test.ts tests/asset_policy.test.ts README.md CONTRIBUTING.md docs/ENGINEERING_STANDARDS.md docs/adr/**/*.md",
    "assets:policy": "node scripts/check-assets.mjs",
    "assets:3d:check": "node tools/3d/CivicAssetCompiler.mjs --check",
    "assets:3d:build": "node tools/3d/CivicAssetCompiler.mjs --build",
    "assets:check": "python tools/render_isometric_atlases.py --check && npm run assets:3d:check",
    "assets:build": "python tools/render_isometric_atlases.py && npm run assets:3d:build",
    "build": "node scripts/build.mjs",
    "verify": "npm run format:check && npm run lint && npm run policy:check && npm run architecture:check && npm run typecheck && npm test && npm run assets:policy && npm run assets:check && npm run build",
    "dev": "python -m http.server 5173 -d dist",
    "desktop": "npm run build && electron desktop/main.mjs",
    "test:smoke": "python tests/smoke/phase6_smoke.py",
    "test:smoke:phase7": "python tests/smoke/phase7_land_housing_smoke.py",
    "test:smoke:urban-fabric": "python tests/smoke/urban_fabric_smoke.py",
    "test:smoke:isometric": "python tests/smoke/isometric_pass_a_smoke.py",
    "test:smoke:3d": "python tests/smoke/civic_3d_house_a_smoke.py",
    "test:smoke:3d-house": "python tests/smoke/civic_3d_house_a_smoke.py",
    "test:smoke:3d:stack3": "python tests/smoke/civic_3d_stack3_smoke.py",
    "review:3d-house": "python tests/smoke/civic_3d_house_a_review.py"
  },
  "dependencies": {
    "@babylonjs/core": "9.23.0",
    "@babylonjs/loaders": "9.23.0",
    "clipper2-ts": "2.0.1-18",
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "electron": "44.0.0",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.67.0"
  }
}
